{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "https://codecollab-backend-a4w0.onrender.com/api/:match*"
    },
    {
      "source": "/((?!assets/|favicon|logo|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
