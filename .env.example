# Clerk Authentication Configuration
# 1. Sign up / log in at https://clerk.com
# 2. Create an application (e.g. CodeCollab)
# 3. Copy your Publishable Key from Dashboard > API Keys
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Backend Service Configuration (Optional: default connects to local server :3001)
# For production (e.g. Render / Railway):
# VITE_API_URL=https://your-backend-service.onrender.com
# VITE_WS_URL=wss://your-backend-service.onrender.com

